function points_inside_polygon(vertices, num_points)
    # Convert vertices to Clipper format
    polygon = Clipper.Path()
    for vertex in vertices
        push!(polygon, Clipper.IntPoint(floor(Int, vertex[1] * 1000), floor(Int, vertex[2] * 1000)))
    end

    # Create a Clipper subject with the polygon
    subject = Clipper.Paths([[Clipper.IntPoint(x, y) for (x, y) in zip(rand(0:1000, num_points), rand(0:1000, num_points))]])

    # Use Clipper to compute intersection of points inside the polygon
    c = Clipper.Clipper()
    c.AddPaths(subject, Clipper.PolyType.ptSubject, true)
    c.AddPath(polygon, Clipper.PolyType.ptClip, true)

    solution = Clipper.Paths()
    c.Execute(Clipper.ClipType.ctIntersection, solution, Clipper.PolyFillType.pftEvenOdd, Clipper.PolyFillType.pftEvenOdd)

    # Convert solution back to GeometryTypes format
    points = Point2f0[]
    for path in solution
        for point in path
            push!(points, Point2f0(point.X / 1000, point.Y / 1000))
        end
    end

    return points
end

